{
  "name": "stellar-agent-pay-cli",
  "version": "0.1.0",
  "description": "CLI that pays an x402-gated URL from the terminal: 402 -> pay -> unlock, for agents and shell scripts",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/StevenMolina22/stellar-agent-pay-cli.git"
  },
  "homepage": "https://stellar-agent-pay-cli.vercel.app",
  "bugs": {
    "url": "https://github.com/StevenMolina22/stellar-agent-pay-cli/issues"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "author": "leocagli",
  "main": "src/pay.js",
  "bin": {
    "stellar-agent-pay": "bin/cli.js",
    "stellar-agent-pay-mcp": "src/mcp.js"
  },
  "files": [
    "src",
    "bin",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc && chmod +x bin/cli.js src/mcp.js",
    "clean": "rm -f src/*.js bin/*.js",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run build",
    "test": "node --test",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "stellar",
    "x402",
    "cli",
    "agent-payments",
    "mcp"
  ],
  "dependencies": {
    "@x402/core": "2.20.0",
    "@x402/fetch": "2.20.0",
    "@x402/stellar": "2.20.0"
  },
  "optionalDependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@types/node": "^26.1.2",
    "@x402/express": "^2.20.0",
    "express": "^5.2.1",
    "stellar-x402-paywall-kit": "^0.1.0",
    "typescript": "^7.0.2",
    "zod": "^3.23.8"
  }
}
